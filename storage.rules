rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Charger photos: chargers/{hostUid}/{chargerId}/{file}
    // Public read (listing photos); only that host can upload, images only, max 5 MB.
    match /chargers/{hostUid}/{chargerId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == hostUid
        && request.auth.token.get('host', false) == true
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && (request.auth.uid == hostUid || request.auth.token.get('admin', false) == true);
    }

    // Check-out meter photos: checkout/{renterUid}/{bookingId}/{file} (used in Phase 5)
    match /checkout/{renterUid}/{bookingId}/{fileName} {
      // Renter, admin, or the host of the booked charger (cross-service lookup of the booking).
      allow read: if request.auth != null && (
        request.auth.uid == renterUid
        || request.auth.token.get('admin', false) == true
        || firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.ownerId == request.auth.uid
      );
      allow create: if request.auth != null && request.auth.uid == renterUid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
