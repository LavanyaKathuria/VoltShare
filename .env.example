# --- Firebase web app config (Firebase console > Project settings > Your apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# "true" = connect the browser SDK to the local Emulator Suite instead of the real project
NEXT_PUBLIC_USE_EMULATORS=true

# --- Razorpay (TEST MODE). Leave blank to use the mocked payment step. ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Open Charge Map (optional): shows public stations as a grey, non-bookable map layer. ---
# Free key: https://openchargemap.org/site/develop/api  (server-side only — NOT NEXT_PUBLIC)
OCM_API_KEY=

# --- Map tiles (optional). Default "osm" = OpenStreetMap, no key needed. ---
# "stadia" = Stadia Maps Alidade Smooth (cleaner). Free account: register your Vercel domain at
# client.stadiamaps.com (then no key is needed), or create an API key and set it below.
NEXT_PUBLIC_MAP_TILES=osm
NEXT_PUBLIC_STADIA_API_KEY=
