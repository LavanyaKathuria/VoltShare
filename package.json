{
  "name": "voltshare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "emulators": "firebase emulators:start --import=./.emulator-data --export-on-exit",
